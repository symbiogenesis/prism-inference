#!/bin/sh
# Inspect the immutable branch/tag updates supplied by Git.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoLogo -NoProfile -NonInteractive -File .github/ci/Check-PushSanity.ps1
fi
echo 'Push blocked: native PowerShell 7.6+ is required for source sanity checks.' >&2
exit 1
